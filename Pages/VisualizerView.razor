@using AlgorithmLab.Visualizer
@using AlgorithmLab.Components

<div class="benchmark-workspace">
    <div class="controls-cockpit liquid-glass">
        <div class="param-group">
            <span class="param-label">Алгоритм:</span>
            <select class="param-input" style="width: 170px;" @bind="selectedAlgorithm" disabled="@isSorting">
                <option value="Bubble Sort">Bubble Sort (Пузырьком)</option>
                <option value="Selection Sort">Selection Sort (Выбором)</option>
                <option value="Insertion Sort">Insertion Sort (Вставками)</option>
                <option value="Quick Sort">Quick Sort (Быстрая)</option>
                <option value="Merge Sort">Merge Sort (Слиянием)</option>
            </select>
        </div>

        <div class="param-group">
            <span class="param-label">Размер (N): @arraySize</span>
            <input type="range" class="checkbox-custom" min="10" max="60" @bind="arraySize" @bind:event="oninput" @onchange="GenerateNewArray" disabled="@isSorting" />
        </div>

        <div class="param-group">
            <span class="param-label">Задержка: @delayMs мс</span>
            <input type="range" class="checkbox-custom" min="5" max="250" step="5" @bind="delayMs" @bind:event="oninput" disabled="@isSorting" />
        </div>

        <div class="btn-actions-group">
            <button class="btn-secondary" @onclick="GenerateNewArray" disabled="@isSorting">
                <SvgIcon Name="refresh" Size="15" />
                <span>Массив</span>
            </button>
            @if (!isSorting)
            {
                <button class="btn-primary" @onclick="StartSorting" disabled="@isCompleted">
                    <SvgIcon Name="play" Size="15" />
                    <span>Старт</span>
                </button>
            }
            else
            {
                <button class="btn-danger" @onclick="PauseSorting">
                    <SvgIcon Name="stop" Size="15" />
                    <span>Пауза</span>
                </button>
            }
            <button class="btn-secondary" @onclick="StepForward" disabled="@(isSorting || isCompleted || steps.Count == 0)">
                <span>Шаг ❯</span>
            </button>
            <button class="btn-secondary" @onclick="ResetVisualizer" disabled="@isSorting">
                <span>Сброс</span>
            </button>
        </div>
    </div>

    <!-- Информационная панель статистики (Cockpit Density) -->
    <div class="telemetry-cockpit">
        <div class="telemetry-metric">
            <span class="metric-label">Сравнений:</span>
            <span class="metric-value amber">@currentSnapshot.Comparisons</span>
        </div>
        <div class="telemetry-metric">
            <span class="metric-label">Перестановок:</span>
            <span class="metric-value ruby">@currentSnapshot.Swaps</span>
        </div>
        <div class="telemetry-metric">
            <span class="metric-label">Прогресс шагов:</span>
            <span class="metric-value cyan">@(currentStepIndex + 1) / @steps.Count</span>
        </div>
        <div class="telemetry-metric" style="flex: 1; justify-content: flex-end;">
            <span class="metric-label">Статус:</span>
            <span class="metric-value emerald">@currentSnapshot.Message</span>
        </div>
    </div>

    <!-- Графическая область со столбиками -->
    <div class="chart-panel liquid-glass" style="padding: 1rem;">
        <div class="bars-canvas" style="height: 380px; background: rgba(8, 12, 20, 0.7); border-radius: 8px;">
            @if (currentSnapshot.Array.Length > 0)
            {
                int maxVal = currentSnapshot.Array.Max();
                @for (int i = 0; i < currentSnapshot.Array.Length; i++)
                {
                    int val = currentSnapshot.Array[i];
                    double heightPercent = Math.Max(12, ((double)val / maxVal) * 92);
                    string barClass = GetBarClass(i);

                    <div class="bar-wrapper" style="width: @(100.0 / currentSnapshot.Array.Length)%">
                        <div class="bar @barClass" style="height: @(heightPercent)%">
                            @if (arraySize <= 25)
                            {
                                <span class="bar-value" style="font-family: var(--font-mono);">@val</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Легенда цветов без эмодзи -->
        <div class="chart-legend-row" style="margin-top: 0.8rem;">
            <div class="legend-badge"><span class="legend-indicator" style="background: #38bdf8;"></span> Исходный</div>
            <div class="legend-badge"><span class="legend-indicator" style="background: #fbbf24;"></span> Сравнение</div>
            <div class="legend-badge"><span class="legend-indicator" style="background: #f43f5e;"></span> Перестановка</div>
            <div class="legend-badge"><span class="legend-indicator" style="background: #c084fc;"></span> Опорный (Pivot)</div>
            <div class="legend-badge"><span class="legend-indicator" style="background: #34d399;"></span> Отсортирован</div>
        </div>
    </div>
</div>

@code {
    private string selectedAlgorithm = "Bubble Sort";
    private int arraySize = 30;
    private int delayMs = 40;
    private int[] initialArray = Array.Empty<int>();

    private List<StepSnapshot> steps = new();
    private int currentStepIndex = 0;
    private StepSnapshot currentSnapshot = new();

    private bool isSorting = false;
    private bool isCompleted = false;
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        GenerateNewArray();
    }

    private void GenerateNewArray()
    {
        PauseSorting();
        var rnd = new Random();
        initialArray = Enumerable.Range(0, arraySize).Select(_ => rnd.Next(10, 100)).ToArray();
        ResetVisualizer();
    }

    private void ResetVisualizer()
    {
        PauseSorting();
        steps = SortingVisualizer.GenerateSteps(selectedAlgorithm, initialArray);
        currentStepIndex = 0;
        isCompleted = false;
        if (steps.Count > 0)
        {
            currentSnapshot = steps[0];
        }
        StateHasChanged();
    }

    private async Task StartSorting()
    {
        if (isCompleted || steps.Count == 0) return;

        isSorting = true;
        cts = new CancellationTokenSource();
        var token = cts.Token;

        try
        {
            while (currentStepIndex < steps.Count - 1 && !token.IsCancellationRequested)
            {
                currentStepIndex++;
                currentSnapshot = steps[currentStepIndex];
                StateHasChanged();

                await Task.Delay(delayMs, token);
            }

            if (currentStepIndex >= steps.Count - 1)
            {
                isCompleted = true;
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            isSorting = false;
            StateHasChanged();
        }
    }

    private void PauseSorting()
    {
        if (cts != null && !cts.IsCancellationRequested)
        {
            cts.Cancel();
        }
        isSorting = false;
        StateHasChanged();
    }

    private void StepForward()
    {
        if (currentStepIndex < steps.Count - 1)
        {
            currentStepIndex++;
            currentSnapshot = steps[currentStepIndex];
            if (currentStepIndex == steps.Count - 1) isCompleted = true;
            StateHasChanged();
        }
    }

    private string GetBarClass(int index)
    {
        if (currentSnapshot.SortedIndices.Contains(index)) return "bar-sorted";
        if (index == currentSnapshot.PivotIndex) return "bar-pivot";
        if (index == currentSnapshot.SwappingIndex1 || index == currentSnapshot.SwappingIndex2) return "bar-swapping";
        if (index == currentSnapshot.ComparingIndex1 || index == currentSnapshot.ComparingIndex2) return "bar-comparing";
        return "bar-default";
    }
}
