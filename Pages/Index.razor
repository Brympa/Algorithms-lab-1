@page "/"
@using AlgorithmLab.Benchmark
@using AlgorithmLab.Interop
@inject ChartInterop Chart

<div class="spa-shell">
    <!-- Верхняя навигационная панель SPA -->
    <header class="spa-header glass">
        <div class="brand">
            <span class="brand-icon">⚡</span>
            <span class="brand-name">AlgorithmLab</span>
        </div>
        <nav class="spa-nav">
            <button class="nav-tab @(activeTab == "benchmark" ? "active" : "")" @onclick='() => SetTab("benchmark")'>
                📈 Бенчмарк сложности (Лабораторная №1)
            </button>
            <button class="nav-tab @(activeTab == "visualizer" ? "active" : "")" @onclick='() => SetTab("visualizer")'>
                📊 Пошаговый визуализатор
            </button>
        </nav>
    </header>

    <!-- Основной контент активной вкладки -->
    <main class="spa-body">
        @if (activeTab == "visualizer")
        {
            <VisualizerView />
        }
        else
        {
            <div class="benchmark-container">
                <div class="benchmark-layout">
                    <!-- Левая панель: выбор алгоритмов по Лабораторной №1 -->
                    <aside class="glass benchmark-sidebar">
                        <h3>1. Векторные функции</h3>
                        @foreach (var key in Algorithms.VectorFunctions.Keys)
                        {
                            <button class="glass-btn @(currentAlgo == key ? "active-algo" : "")" @onclick="() => RunBenchmark(key)">
                                @key
                            </button>
                        }

                        <h3>2. Сортировки</h3>
                        @foreach (var key in Algorithms.Sorts.Keys)
                        {
                            <button class="glass-btn @(currentAlgo == key ? "active-algo" : "")" @onclick="() => RunBenchmark(key)">
                                @key
                            </button>
                        }

                        <h3>3. Возведение в степень</h3>
                        @foreach (var key in Algorithms.PowAlgorithms.Keys)
                        {
                            <button class="glass-btn @(currentAlgo == key ? "active-algo" : "")" @onclick="() => RunBenchmark(key)">
                                @key
                            </button>
                        }

                        <h3>4. Матрицы</h3>
                        @foreach (var key in Algorithms.MatrixAlgorithms.Keys)
                        {
                            <button class="glass-btn @(currentAlgo == key ? "active-algo" : "")" @onclick="() => RunBenchmark(key)">
                                @key
                            </button>
                        }
                    </aside>

                    <!-- Правая панель: График Chart.js -->
                    <main class="glass benchmark-chart-panel">
                        <div class="chart-header">
                            <h2>Анализ временной сложности: @(string.IsNullOrEmpty(currentAlgo) ? "Выберите алгоритм из списка слева" : currentAlgo)</h2>
                            @if (isRunning)
                            {
                                <div class="benchmark-status text-blue">
                                    <span>⏳</span> Тестирование N = @progress...
                                </div>
                            }
                        </div>
                        <div class="canvas-wrapper">
                            <canvas id="chart" width="800" height="420"></canvas>
                        </div>
                    </main>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private string activeTab = "benchmark";
    private string currentAlgo = "";
    private bool isRunning = false;
    private int progress = 0;

    private List<int> lastLabels = new();
    private List<double> lastEmpData = new();
    private List<double> lastTheoData = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && activeTab == "benchmark" && string.IsNullOrEmpty(currentAlgo))
        {
            // Запуск по умолчанию первого алгоритма из ТЗ
            await RunBenchmark("Сумма элементов (Sum)");
        }
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
        if (activeTab == "benchmark" && !string.IsNullOrEmpty(currentAlgo))
        {
            await Task.Delay(50);
            await ReRenderChart();
        }
    }

    private async Task RunBenchmark(string key)
    {
        if (isRunning) return;

        isRunning = true;
        currentAlgo = key;
        progress = 0;
        StateHasChanged();

        await Task.Delay(20);

        var results = await Task.Run(() =>
        {
            return Runner.Run(key, n => { progress = n; InvokeAsync(StateHasChanged); });
        });

        lastLabels = results.Select(r => r.N).ToList();
        lastEmpData = results.Select(r => r.AvgMs).ToList();
        lastTheoData = results.Select(r => r.TheoMs).ToList();

        await ReRenderChart();

        isRunning = false;
        StateHasChanged();
    }

    private async Task ReRenderChart()
    {
        if (lastLabels.Count > 0)
        {
            await Chart.RenderAsync("chart", lastLabels, lastEmpData, lastTheoData);
        }
    }
}