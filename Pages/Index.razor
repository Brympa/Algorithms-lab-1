@page "/"
@using AlgorithmLab.Services
@using AlgorithmLab.Components

@inject IExperimentStorageService Storage

<div class="app-container">
    <!-- Шапка SPA с фирменным стилем Liquid Glass -->
    <header class="app-header liquid-glass">
        <div class="brand-section">
            <SvgIcon Name="chart" Class="brand-logo-icon" Size="26" />
            <span class="brand-title">AlgorithmLab</span>
            <span class="brand-badge">.NET 10 WASM</span>
        </div>

        <!-- Живой индикатор подключения к БД -->
        <div class="header-status-badge">
            <span class="status-dot @(Storage.Status == DatabaseStatus.ConnectedPostgreSql ? "online" : "local")"></span>
            <span>@Storage.StatusMessage</span>
        </div>
    </header>

    <!-- Навигационные вкладки без эмодзи по design-taste-frontend -->
    <nav class="tabs-navigation">
        <button class="tab-btn @(activeTab == "benchmark" ? "active" : "")" @onclick='() => SetTab("benchmark")'>
            <SvgIcon Name="chart" Size="16" />
            <span>Бенчмарк сложности</span>
        </button>

        <button class="tab-btn @(activeTab == "powersteps" ? "active" : "")" @onclick='() => SetTab("powersteps")'>
            <SvgIcon Name="steps" Size="16" />
            <span>Анализ шагов xⁿ (Часть IV)</span>
        </button>

        <button class="tab-btn @(activeTab == "matrix3d" ? "active" : "")" @onclick='() => SetTab("matrix3d")'>
            <SvgIcon Name="matrix" Size="16" />
            <span>3D Матрицы n×m (Часть II)</span>
        </button>

        <button class="tab-btn @(activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
            <SvgIcon Name="compare" Size="16" />
            <span>Сравнение из истории</span>
        </button>

        <button class="tab-btn @(activeTab == "visualizer" ? "active" : "")" @onclick='() => SetTab("visualizer")'>
            <SvgIcon Name="visualizer" Size="16" />
            <span>Визуализатор сортировок</span>
        </button>

        <button class="tab-btn @(activeTab == "config" ? "active" : "")" @onclick='() => SetTab("config")'>
            <SvgIcon Name="database" Size="16" />
            <span>Конфигурация и БД</span>
        </button>
    </nav>

    <!-- Основной контент выбранной вкладки -->
    <main>
        @switch (activeTab)
        {
            case "benchmark":
                <BenchmarkView />
                break;
            case "powersteps":
                <PowerStepsView />
                break;
            case "matrix3d":
                <Matrix3DView />
                break;
            case "history":
                <HistoryComparison />
                break;
            case "visualizer":
                <VisualizerView />
                break;
            case "config":
                <ConfigManagerView />
                break;
            default:
                <BenchmarkView />
                break;
        }
    </main>
</div>

@code {
    private string activeTab = "benchmark";

    protected override async Task OnInitializedAsync()
    {
        Storage.OnStatusChanged += () => InvokeAsync(StateHasChanged);
        await Storage.CheckConnectionAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }
}