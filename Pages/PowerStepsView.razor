@using AlgorithmLab.Core.Algorithms
@using AlgorithmLab.Core.Benchmark
@using AlgorithmLab.Core.Dataset
@using AlgorithmLab.Core.Models
@using AlgorithmLab.Interop
@using AlgorithmLab.Components

@inject IAlgorithmRegistry Registry
@inject IMasterDatasetProvider DatasetProvider
@inject PrecisionBenchmarkEngine BenchmarkEngine
@inject ChartInterop Chart

<div class="benchmark-workspace">
    <!-- Описание задания Части IV -->
    <div class="controls-cockpit liquid-glass" style="flex-direction: column; align-items: flex-start; gap: 0.6rem;">
        <div style="font-size: 1rem; font-weight: 700; color: var(--accent-cyan);">
            Часть IV. Анализ алгоритмов возведения в степень f(x) = xⁿ (Подсчет элементарных шагов)
        </div>
        <div style="font-size: 0.84rem; color: var(--text-secondary); line-height: 1.5;">
            По техническому заданию основным измеряемым параметром является <strong>не время, а точное количество операций (шагов)</strong> — умножений и вызовов для \(n \in [1, 1000]\).
        </div>
    </div>

    <!-- Панель управления с современными степперами -->
    <div class="controls-cockpit liquid-glass">
        <div class="param-group">
            <span class="param-label">Основание x:</span>
            <input type="number" step="0.05" class="param-input" style="width: 70px;" @bind="baseX" disabled="@isRunning" />
        </div>
        <div class="param-group">
            <span class="param-label">N max:</span>
            <NumericStepper @bind-Value="nMax" Min="10" Max="2000" Step="50" Disabled="@isRunning" Width="75" />
        </div>
        <div class="param-group">
            <span class="param-label">Шаг:</span>
            <NumericStepper @bind-Value="step" Min="1" Max="100" Step="5" Disabled="@isRunning" Width="65" />
        </div>

        <div class="btn-actions-group">
            @if (!isRunning)
            {
                <button class="btn-primary" @onclick="RunComparisonAsync">
                    <SvgIcon Name="play" Size="16" />
                    <span>Сравнить все 3 алгоритма</span>
                </button>
            }
            else
            {
                <button class="btn-danger" @onclick="Stop">
                    <SvgIcon Name="stop" Size="16" />
                    <span>Прервать</span>
                </button>
            }
        </div>
    </div>

    <!-- График количества операций в реальном времени -->
    <div class="chart-panel liquid-glass">
        <div class="chart-header">
            <div class="chart-title-box">
                <h2>Сравнение количества элементарных операций от степени n (Потоковый режим)</h2>
                <div class="chart-subtitle">
                    Итеративный O(n) против Рекурсивного O(n) и Быстрого бинарного O(log n)
                </div>
            </div>
            @if (isRunning)
            {
                <div class="header-status-badge">
                    <span class="status-dot pulsing"></span>
                    <span>Расчет n = @currentProgressN...</span>
                </div>
            }
        </div>

        <div class="chart-canvas-container">
            <canvas id="stepsChartCanvas"></canvas>
        </div>
    </div>

    <!-- Таблица результатов замеров шагов -->
    @if (comparisonTable.Count > 0)
    {
        <div class="chart-panel liquid-glass">
            <h3 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.8rem;">Сводные контрольные замеры шагов</h3>
            <table class="table-cockpit">
                <thead>
                    <tr>
                        <th>Степень (n)</th>
                        <th>10. Простой итеративный (шагов)</th>
                        <th>11. Рекурсивный x·xⁿ⁻¹ (шагов)</th>
                        <th>12. Быстрый бинарный (шагов)</th>
                        <th>Выигрыш быстрого алгоритма</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in comparisonTable)
                    {
                        <tr>
                            <td class="mono-cell" style="color: var(--accent-cyan);">n = @row.N</td>
                            <td class="mono-cell">@row.IterativeSteps</td>
                            <td class="mono-cell">@row.RecursiveSteps</td>
                            <td class="mono-cell" style="color: var(--accent-emerald); font-weight: 700;">@row.FastSteps</td>
                            <td class="mono-cell" style="color: var(--accent-amber);">
                                @(row.FastSteps > 0 ? $"в {(double)row.IterativeSteps / row.FastSteps:F1} раз" : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private double baseX = 1.5;
    private int nMax = 1000;
    private int step = 20;
    private bool isRunning = false;
    private int currentProgressN = 0;
    private CancellationTokenSource? cts;

    private record StepRow(int N, long IterativeSteps, long RecursiveSteps, long FastSteps);
    private List<StepRow> comparisonTable = new();

    private readonly List<string> seriesNames = new()
    {
        "10. Простой итеративный (умножения)",
        "11. Рекурсивный x·xⁿ⁻¹ (вызовы + умножения)",
        "12. Быстрый бинарный O(log n)"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(150);
            await Chart.InitMultiLiveChartAsync("stepsChartCanvas", "Сравнение шагов возведения в степень", seriesNames, "Количество шагов");
        }
    }

    private async Task RunComparisonAsync()
    {
        if (isRunning) return;
        isRunning = true;
        comparisonTable.Clear();
        currentProgressN = 1;
        cts = new CancellationTokenSource();
        StateHasChanged();

        var iterative = new SimpleIterativePowerAlgorithm();
        var recursive = new RecursivePowerAlgorithm();
        var fastBinary = new FastBinaryPowerAlgorithm();

        try
        {
            await Chart.InitMultiLiveChartAsync("stepsChartCanvas", "Сравнение шагов возведения в степень", seriesNames, "Количество шагов");

            for (int n = 1; n <= nMax; n += step)
            {
                cts.Token.ThrowIfCancellationRequested();

                var r1 = iterative.ExecuteWithSteps(baseX, n);
                var r2 = recursive.ExecuteWithSteps(baseX, n);
                var r3 = fastBinary.ExecuteWithSteps(baseX, n);

                currentProgressN = n;

                // Потоковая отправка трех точек одновременно в реальном времени
                await Chart.AppendMultiLivePointAsync("stepsChartCanvas", n, new double[] { r1.StepCount, r2.StepCount, r3.StepCount });

                if (n % 100 == 0 || n == 1 || n >= nMax - step)
                {
                    comparisonTable.Add(new StepRow(n, r1.StepCount, r2.StepCount, r3.StepCount));
                    await InvokeAsync(StateHasChanged);
                }

                // Плавная задержка для красивого живого роста графиков
                await Task.Delay(15, cts.Token);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[PowerStepsView] Error: {ex.Message}");
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private void Stop()
    {
        cts?.Cancel();
        isRunning = false;
        StateHasChanged();
    }
}
