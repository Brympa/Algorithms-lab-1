@using System.Text.Json
@using AlgorithmLab.Core.Algorithms
@using AlgorithmLab.Core.Benchmark
@using AlgorithmLab.Core.Dataset
@using AlgorithmLab.Core.Models
@using AlgorithmLab.Interop
@using AlgorithmLab.Services
@using AlgorithmLab.Components

@implements IDisposable

@inject IAlgorithmRegistry Registry
@inject IMasterDatasetProvider DatasetProvider
@inject PrecisionBenchmarkEngine BenchmarkEngine
@inject ChartInterop Chart
@inject IExperimentStorageService Storage
@inject BenchmarkQueueService QueueService
@inject IJSRuntime JS

<div class="benchmark-grid">
    <!-- Левая панель: выбор исследуемого алгоритма -->
    <aside class="algo-sidebar liquid-glass">
        <div>
            <div class="sidebar-category-title">1. Операции с векторами</div>
            <div class="algo-button-list">
                @foreach (var algo in Registry.GetByCategory(AlgorithmCategory.Vectors))
                {
                    bool isRunningAlgo = QueueService.CurrentRunningItem?.Algorithm.Id == algo.Id;
                    bool isQueuedAlgo = QueueService.Items.Any(x => x.Algorithm.Id == algo.Id && x.Status == QueueItemStatus.Queued);

                    <button class="algo-selector-btn @(currentAlgorithm?.Id == algo.Id ? "active" : "") @(isRunningAlgo ? "running-border" : "")"
                            @onclick="() => SelectAlgorithm(algo)">
                        <span>@algo.Name</span>
                        <div style="display: flex; align-items: center; gap: 0.35rem;">
                            @if (isRunningAlgo)
                            {
                                <span class="status-dot pulsing online" title="Алгоритм сейчас выполняется"></span>
                            }
                            else if (isQueuedAlgo)
                            {
                                <span class="status-dot pulsing local" title="В очереди на выполнение"></span>
                            }
                            <span class="complexity-pill">@algo.ComplexityDisplay</span>
                        </div>
                    </button>
                }
            </div>
        </div>

        <div>
            <div class="sidebar-category-title">2. Сортировки массивов</div>
            <div class="algo-button-list">
                @foreach (var algo in Registry.GetByCategory(AlgorithmCategory.Sorts))
                {
                    bool isRunningAlgo = QueueService.CurrentRunningItem?.Algorithm.Id == algo.Id;
                    bool isQueuedAlgo = QueueService.Items.Any(x => x.Algorithm.Id == algo.Id && x.Status == QueueItemStatus.Queued);

                    <button class="algo-selector-btn @(currentAlgorithm?.Id == algo.Id ? "active" : "") @(isRunningAlgo ? "running-border" : "")"
                            @onclick="() => SelectAlgorithm(algo)">
                        <span>@algo.Name</span>
                        <div style="display: flex; align-items: center; gap: 0.35rem;">
                            @if (isRunningAlgo)
                            {
                                <span class="status-dot pulsing online" title="Алгоритм сейчас выполняется"></span>
                            }
                            else if (isQueuedAlgo)
                            {
                                <span class="status-dot pulsing local" title="В очереди на выполнение"></span>
                            }
                            <span class="complexity-pill">@algo.ComplexityDisplay</span>
                        </div>
                    </button>
                }
            </div>
        </div>

        <div>
            <div class="sidebar-category-title">3. Индивидуальное задание (Часть III)</div>
            <div class="algo-button-list">
                @foreach (var algo in Registry.GetByCategory(AlgorithmCategory.Individual))
                {
                    bool isRunningAlgo = QueueService.CurrentRunningItem?.Algorithm.Id == algo.Id;
                    bool isQueuedAlgo = QueueService.Items.Any(x => x.Algorithm.Id == algo.Id && x.Status == QueueItemStatus.Queued);

                    <button class="algo-selector-btn @(currentAlgorithm?.Id == algo.Id ? "active" : "") @(isRunningAlgo ? "running-border" : "")"
                            @onclick="() => SelectAlgorithm(algo)">
                        <span>@algo.Name</span>
                        <div style="display: flex; align-items: center; gap: 0.35rem;">
                            @if (isRunningAlgo)
                            {
                                <span class="status-dot pulsing online" title="Алгоритм сейчас выполняется"></span>
                            }
                            else if (isQueuedAlgo)
                            {
                                <span class="status-dot pulsing local" title="В очереди на выполнение"></span>
                            }
                            <span class="complexity-pill">@algo.ComplexityDisplay</span>
                        </div>
                    </button>
                }
            </div>
        </div>
    </aside>

    <!-- Правая область: Панель приборов, очередь и Live-график -->
    <main class="benchmark-workspace">
        @if (currentAlgorithm != null)
        {
            <!-- Панель управления параметрами (Cockpit Density) -->
            <div class="controls-cockpit liquid-glass">
                <div class="param-group">
                    <span class="param-label">N min:</span>
                    <NumericStepper @bind-Value="nMin" Min="1" Max="2147483646" Step="10" Width="72" />
                </div>
                <div class="param-group">
                    <span class="param-label">N max:</span>
                    <NumericStepper @bind-Value="nMax" Min="10" Max="2147483647" Step="50" Width="82" />
                </div>
                <div class="param-group">
                    <span class="param-label">Шаг:</span>
                    <NumericStepper @bind-Value="step" Min="1" Max="2147483647" Step="10" Width="68" />
                </div>
                <div class="param-group">
                    <span class="param-label">Прогонов:</span>
                    <NumericStepper @bind-Value="runsPerN" Min="1" Max="20" Step="1" Width="55" />
                </div>

                <!-- Чекбокс принудительного перерасчета в едином стиле checkbox-prominent -->
                <div class="param-group" style="gap: 0.6rem; align-items: center;">
                    <input type="checkbox" id="forceRecalc" class="checkbox-prominent" style="margin: 0;" @bind="forceRecalculate" />
                    <label for="forceRecalc" class="param-label" style="cursor: pointer; user-select: none; font-weight: 500;">
                        Принудительный пересчет
                    </label>
                </div>

                <div class="btn-actions-group">
                    <!-- Селектор движка выполнения в едином стиле Cockpit / Liquid Glass -->
                    <div class="engine-dropdown-wrapper">
                        <button type="button" 
                                class="engine-dropdown-trigger @(isEngineDropdownOpen ? "active" : "")" 
                                @onclick="() => isEngineDropdownOpen = !isEngineDropdownOpen"
                                title="Выбор движка вычислений">
                            <SvgIcon Name="cpu" Size="15" Class="icon-cyan" />
                            <span class="engine-dropdown-label">Движок:</span>
                            <div class="engine-current-badge">
                                <span class="status-dot @(QueueService.EngineMode == ExecutionEngineMode.ServerNative ? "online pulsing" : "local")"></span>
                                <span class="engine-current-text">
                                    @(QueueService.EngineMode == ExecutionEngineMode.ServerNative ? $"Сервер Native ({QueueService.DetectedCpuName})" : "Браузер WASM (Локально)")
                                </span>
                            </div>
                            <SvgIcon Name="@(isEngineDropdownOpen ? "chevron-up" : "chevron-down")" Size="13" Class="engine-chevron" />
                        </button>

                        @if (isEngineDropdownOpen)
                        {
                            <div class="engine-dropdown-backdrop" @onclick="() => isEngineDropdownOpen = false"></div>
                            <div class="engine-dropdown-menu liquid-glass">
                                <div class="engine-dropdown-item @(QueueService.EngineMode == ExecutionEngineMode.ServerNative ? "selected" : "")"
                                     @onclick="() => SelectEngine(ExecutionEngineMode.ServerNative)">
                                    <div class="engine-item-header">
                                        <span class="status-dot online pulsing"></span>
                                        <span class="engine-item-title">Сервер Native (.NET 10 / @QueueService.DetectedCpuName)</span>
                                        @if (QueueService.EngineMode == ExecutionEngineMode.ServerNative)
                                        {
                                            <SvgIcon Name="check" Size="14" Class="icon-emerald" />
                                        }
                                    </div>
                                    <div class="engine-item-desc">
                                        @(string.IsNullOrEmpty(QueueService.DetectedCpuFullName) ? "Многопоточный расчет на бэкенде, 0% нагрузки на UI браузера" : $"{QueueService.DetectedCpuFullName} ({QueueService.DetectedCores} потоков), 0% нагрузки на UI")
                                    </div>
                                </div>

                                <div class="engine-dropdown-item @(QueueService.EngineMode == ExecutionEngineMode.BrowserWasm ? "selected" : "")"
                                     @onclick="() => SelectEngine(ExecutionEngineMode.BrowserWasm)">
                                    <div class="engine-item-header">
                                        <span class="status-dot local"></span>
                                        <span class="engine-item-title">Браузер WASM (Локально)</span>
                                        @if (QueueService.EngineMode == ExecutionEngineMode.BrowserWasm)
                                        {
                                            <SvgIcon Name="check" Size="14" Class="icon-emerald" />
                                        }
                                    </div>
                                    <div class="engine-item-desc">
                                        Автономное выполнение в WebAssembly с кооперативным расписанием (Task.Yield)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!QueueService.IsRunning)
                    {
                        <button class="btn-primary" @onclick="StartBenchmark">
                            <SvgIcon Name="play" Size="16" />
                            <span>Запуск</span>
                        </button>
                    }
                    else
                    {
                        <button class="btn-primary" @onclick="EnqueueCurrent">
                            <SvgIcon Name="plus" Size="16" />
                            <span>В очередь</span>
                        </button>
                        <button class="btn-danger" @onclick="QueueService.CancelCurrent" title="Остановить текущий расчет">
                            <SvgIcon Name="stop" Size="16" />
                            <span>Прервать</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Интерактивная панель очереди выполнения (сворачиваемая) -->
            @if (QueueService.Items.Count > 0)
            {
                <div class="chart-panel liquid-glass" style="padding: 0.75rem 1.25rem;">
                    <div class="chart-header" style="margin-bottom: @(isQueueExpanded ? "0.6rem" : "0"); align-items: center; cursor: pointer;" @onclick="() => isQueueExpanded = !isQueueExpanded">
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <span class="status-dot @(QueueService.IsRunning ? "online pulsing" : "local")"></span>
                            <h3 style="font-size: 0.92rem; font-weight: 600; margin: 0;">Очередь задач выполнения</h3>
                            <span class="brand-badge" style="font-size: 0.72rem;">
                                @QueueService.Items.Count(x => x.Status == QueueItemStatus.Queued) в очереди
                            </span>
                            @if (!isQueueExpanded && QueueService.CurrentRunningItem != null)
                            {
                                <span class="source-badge pg" style="color: var(--accent-cyan); font-size: 0.72rem;">
                                    Выполняется: @QueueService.CurrentRunningItem.Algorithm.Name (@QueueService.CurrentRunningItem.CurrentProgressN / @QueueService.CurrentRunningItem.NMax)
                                </span>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;" @onclick:stopPropagation="true">
                            @if (QueueService.Items.Any(x => x.Status == QueueItemStatus.Queued))
                            {
                                <button class="btn-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;" @onclick="QueueService.ClearQueue">
                                    <SvgIcon Name="trash" Size="13" />
                                    <span>Очистить</span>
                                </button>
                            }
                            <button class="filter-reset-btn" style="padding: 0.2rem 0.5rem;" @onclick="() => isQueueExpanded = !isQueueExpanded" title="@(isQueueExpanded ? "Свернуть список" : "Развернуть список")">
                                <SvgIcon Name="@(isQueueExpanded ? "chevron-up" : "chevron-down")" Size="15" />
                            </button>
                        </div>
                    </div>

                    @if (isQueueExpanded)
                    {
                        <div style="display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.5rem;">
                            @foreach (var item in QueueService.Items.TakeLast(6))
                            {
                                bool isCurrent = item.Status == QueueItemStatus.Running;
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; background: rgba(10, 15, 29, 0.6); border-radius: var(--radius-sm); border: 1px solid @(isCurrent ? "rgba(56, 189, 248, 0.4)" : "rgba(255, 255, 255, 0.05)");">
                                    <div style="display: flex; align-items: center; gap: 0.6rem;">
                                        @if (isCurrent)
                                        {
                                            <span class="status-dot pulsing online"></span>
                                        }
                                        <span style="font-weight: 600; font-size: 0.82rem; color: var(--text-primary);">@item.Algorithm.Name</span>
                                        <span class="mono-cell" style="font-size: 0.75rem; color: var(--text-muted);">
                                            N: @item.NMin..@item.NMax (шаг @item.Step)
                                        </span>
                                    </div>

                                    <div style="display: flex; align-items: center; gap: 0.6rem;">
                                        @if (item.Status == QueueItemStatus.Running)
                                        {
                                            <span class="source-badge pg" style="color: var(--accent-cyan);">
                                                Выполняется (@item.CurrentProgressN / @item.NMax)
                                            </span>
                                        }
                                        else if (item.Status == QueueItemStatus.Queued)
                                        {
                                            <span class="source-badge local">Ожидает</span>
                                            <button class="filter-reset-btn" style="padding: 0.15rem 0.4rem;" @onclick="() => QueueService.RemoveItem(item.Id)">
                                                <SvgIcon Name="x" Size="12" />
                                            </button>
                                        }
                                        else if (item.Status == QueueItemStatus.Completed)
                                        {
                                            <span class="source-badge pg" style="color: var(--accent-emerald);">
                                                Готово (@FormatDuration(item.TotalDurationMs))
                                            </span>
                                        }
                                        else if (item.Status == QueueItemStatus.Canceled)
                                        {
                                            <span class="source-badge local" style="color: var(--accent-ruby);">Отменено</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Телеметрия и индикаторы качества аппроксимации -->
            <div class="telemetry-cockpit">
                <div class="telemetry-metric">
                    <span class="metric-label">Размер N:</span>
                    <span class="metric-value cyan">
                        @(isCurrentAlgoRunning ? $"{currentProgressN} / {nMax}" : $"{currentProgressN}")
                    </span>
                </div>
                <div class="telemetry-metric">
                    <span class="metric-label">Выбросы:</span>
                    <span class="metric-value ruby">@outliersCount</span>
                </div>
                <div class="telemetry-metric">
                    <span class="metric-label">Время построения:</span>
                    <span class="metric-value amber">
                        @(lastResult != null ? FormatDuration(lastResult.TotalDurationMs) : (isCurrentAlgoRunning ? "Замер..." : "—"))
                    </span>
                </div>
                <div class="telemetry-metric">
                    <span class="metric-label">Коэффициент C:</span>
                    <span class="metric-value amber">@(lastResult?.CFactor.HasValue == true ? $"{lastResult.CFactor.Value:E3}" : "—")</span>
                </div>
                <div class="telemetry-metric">
                    <span class="metric-label">MSE ошибки:</span>
                    <span class="metric-value emerald">@(lastResult?.MSE.HasValue == true ? $"{lastResult.MSE.Value:E4}" : "—")</span>
                </div>
                <div class="telemetry-metric">
                    @if (currentAlgorithm?.Complexity == ComplexityType.O1)
                    {
                        <span class="metric-label" title="Коэффициент вариации CV = (σ/μ) × 100%: объективная мера стабильности константной функции O(1)">CV вариация (σ/μ):</span>
                        <span class="metric-value cyan" title="Коэффициент вариации: чем ниже процент, тем выше стабильность константы">
                            @(lastResult?.CV.HasValue == true ? $"{lastResult.CV.Value:F2}%" : "—")
                        </span>
                    }
                    else
                    {
                        <span class="metric-label">R² качество:</span>
                        <span class="metric-value cyan">@(lastResult?.RSquared.HasValue == true ? $"{lastResult.RSquared.Value:F4}" : "—")</span>
                    }
                </div>
            </div>

            <!-- Прогресс выполнения -->
            @if (isCurrentAlgoRunning)
            {
                <div class="live-progress-track">
                    <div class="live-progress-fill" style="width: @(CalculateProgressPercent())%;"></div>
                </div>
            }

            <!-- Панель интерактивного графика -->
            <div class="chart-panel liquid-glass">
                <div class="chart-header">
                    <div class="chart-title-box">
                        <h2>@currentAlgorithm?.Name</h2>
                        <div class="chart-subtitle">
                            Теоретическая сложность: <span class="complexity-pill">@currentAlgorithm?.ComplexityDisplay</span>
                            | Данные: Master Dataset (@DatasetProvider.Config.Distribution)
                            @if (isFromCache)
                            {
                                <span class="brand-badge" style="margin-left: 0.5rem;">Кэш данных</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="chart-canvas-container">
                    <canvas id="liveChartCanvas"></canvas>
                </div>

                <div class="chart-legend-row">
                    <div class="legend-badge">
                        <span class="legend-indicator empirical"></span>
                        <span>Экспериментальные замеры (среднее по @runsPerN запускам)</span>
                    </div>
                    <div class="legend-badge">
                        <span class="legend-indicator theoretical"></span>
                        <span>Аппроксимация МНК: T(n) = C · g(n)</span>
                    </div>
                    <div class="legend-badge">
                        <span class="legend-indicator outlier"></span>
                        <span>Выброс (системная задержка / GC pause)</span>
                    </div>
                </div>
            </div>

            <!-- Описание алгоритма и практическое применение для отчета по ГОСТ -->
            <div class="telemetry-cockpit" style="flex-direction: column; align-items: flex-start; gap: 0.5rem;">
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-primary);">
                    Описание и назначение (по ТЗ):
                </div>
                <div style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4;">
                    @currentAlgorithm?.Description
                </div>
                <div style="font-size: 0.78rem; color: var(--accent-cyan); margin-top: 0.2rem;">
                    <strong>Практическое применение:</strong> @currentAlgorithm?.PracticalApplication
                </div>
            </div>
        }
    </main>
</div>

@code {
    private IAlgorithm? currentAlgorithm;
    private int nMin = 50;
    private int nMax = 2000;
    private int step = 50;
    private int runsPerN = 5;
    private bool forceRecalculate = false;
    private bool isQueueExpanded = true;
    private bool isEngineDropdownOpen = false;

    private void SelectEngine(ExecutionEngineMode mode)
    {
        QueueService.EngineMode = mode;
        isEngineDropdownOpen = false;
    }

    private int currentProgressN = 0;
    private int outliersCount = 0;
    private bool isFromCache = false;
    private ExperimentRecord? lastResult;

    private bool isCurrentAlgoRunning => QueueService.CurrentRunningItem?.Algorithm.Id == currentAlgorithm?.Id;

    protected override async Task OnInitializedAsync()
    {
        QueueService.OnQueueChanged += HandleQueueState;
        QueueService.OnItemStarted += HandleItemStarted;
        QueueService.OnPointComputed += HandlePointComputed;
        QueueService.OnItemCompleted += HandleItemCompleted;

        // Восстанавливаем пользовательские параметры эксперимента (если были)
        await LoadExperimentParamsAsync();

        var algos = Registry.GetByCategory(AlgorithmCategory.Vectors);
        if (algos.Count > 1)
        {
            SelectAlgorithm(algos[1]); // Сумма элементов по умолчанию
        }
    }

    public void Dispose()
    {
        QueueService.OnQueueChanged -= HandleQueueState;
        QueueService.OnItemStarted -= HandleItemStarted;
        QueueService.OnPointComputed -= HandlePointComputed;
        QueueService.OnItemCompleted -= HandleItemCompleted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && currentAlgorithm != null)
        {
            await Task.Delay(150);
            await Chart.InitLiveChartAsync("liveChartCanvas", currentAlgorithm.Name);
        }
    }

    private void SelectAlgorithm(IAlgorithm algo)
    {
        bool isFirstSelection = currentAlgorithm == null;
        bool sameAlgo = currentAlgorithm?.Id == algo.Id;

        currentAlgorithm = algo;

        // При первом выборе — дефолты алгоритма; дальше параметры НЕ сбрасываем
        // (иначе при переключении приходится вводить N/шаг заново).
        if (isFirstSelection)
        {
            nMin = algo.DefaultNMin;
            nMax = algo.DefaultNMax;
            step = algo.DefaultStep;
            if (runsPerN <= 0) runsPerN = 5;
        }
        else if (!sameAlgo)
        {
            // Лёгкая подстройка, чтобы N min/max оставались валидными для нового алгоритма
            if (nMax < nMin)
            {
                nMax = Math.Max(nMin, algo.DefaultNMax);
            }
            if (step <= 0)
            {
                step = algo.DefaultStep;
            }
            if (runsPerN <= 0)
            {
                runsPerN = 5;
            }
        }

        currentProgressN = 0;
        outliersCount = 0;
        isFromCache = false;
        lastResult = null;

        _ = RestoreChartForAlgorithmAsync(algo);
    }

    /// <summary>
    /// Выбор алгоритма: готовый результат — сразу полный график;
    /// идёт выполнение — восстановить прогресс; иначе — кэш/история без пересчёта.
    /// </summary>
    private async Task RestoreChartForAlgorithmAsync(IAlgorithm algo)
    {
        var isSteps = algo is IStepCountableAlgorithm;

        var completed = QueueService.Items.LastOrDefault(x => x.Algorithm.Id == algo.Id && x.Status == QueueItemStatus.Completed);
        if (completed?.Result != null)
        {
            await Chart.InitLiveChartAsync("liveChartCanvas", algo.Name, isStepCounting: isSteps);
            RenderCompletedResult(completed.Result);
            await InvokeAsync(StateHasChanged);
            return;
        }

        var running = QueueService.Items.LastOrDefault(x => x.Algorithm.Id == algo.Id && x.Status == QueueItemStatus.Running);
        if (running != null)
        {
            await Chart.InitLiveChartAsync("liveChartCanvas", algo.Name, isStepCounting: isSteps);
            isFromCache = false;
            lastResult = null;
            currentProgressN = running.CurrentProgressN;
            outliersCount = running.OutliersCount;

            if (running.LivePoints.Count > 0)
            {
                var labels = running.LivePoints.Select(p => p.N).ToList();
                List<double> emp = isSteps
                    ? running.LivePoints.Select(p => (double)p.StepCount).ToList()
                    : running.LivePoints.Select(p => p.AvgMs).ToList();
                List<double>? theo = isSteps
                    ? null
                    : running.LivePoints.Select(p => p.TheoMs).ToList();
                var outs = running.LivePoints
                    .Select((p, i) => (p, i))
                    .Where(t => t.p.IsOutlier)
                    .Select(t => t.i)
                    .ToList();
                await Chart.FinalizeChartAsync("liveChartCanvas", labels, emp, theo, outs);
            }

            await InvokeAsync(StateHasChanged);
            return;
        }

        await Chart.InitLiveChartAsync("liveChartCanvas", algo.Name, isStepCounting: isSteps);
        await TryRenderFromCacheAsync(algo);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Мгновенная отрисовка уже посчитанных точек из storage — без повторного прогона.
    /// </summary>
    private async Task TryRenderFromCacheAsync(IAlgorithm algo)
    {
        try
        {
            var configHash = DatasetProvider.Config.ComputeHash();
            var points = await Storage.GetCachedPointsAsync(algo.Id, configHash);
            if (points == null || points.Count < 2)
            {
                var history = await Storage.GetHistoryAsync();
                var exp = history.FirstOrDefault(h => h.AlgorithmId == algo.Id && h.Points.Count >= 2);
                if (exp?.Points?.Count >= 2)
                {
                    points = exp.Points.OrderBy(p => p.N).ToList();
                }
            }

            if (points == null || points.Count < 2) return;

            points = points.OrderBy(p => p.N).ToList();
            isFromCache = true;
            currentProgressN = points[^1].N;
            outliersCount = points.Count(p => p.IsOutlier);

            var labels = points.Select(p => p.N).ToList();
            List<double> empData;
            List<double>? theoData;
            if (algo is IStepCountableAlgorithm)
            {
                empData = points.Select(p => (double)p.StepCount).ToList();
                theoData = null;
            }
            else
            {
                empData = points.Select(p => p.AvgMs).ToList();
                theoData = points.Select(p => p.TheoMs).ToList();
            }

            var outlierIndices = points
                .Select((p, idx) => (p, idx))
                .Where(t => t.p.IsOutlier)
                .Select(t => t.idx)
                .ToList();

            await Chart.FinalizeChartAsync("liveChartCanvas", labels, empData, theoData, outlierIndices);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BenchmarkView] cache restore: {ex.Message}");
        }
    }

    private double CalculateProgressPercent()
    {
        if (nMax <= nMin) return 100.0;
        double progress = (double)(currentProgressN - nMin) / (nMax - nMin) * 100.0;
        return Math.Clamp(progress, 0.0, 100.0);
    }

    private static string FormatDuration(double ms)
    {
        if (ms >= 1000)
        {
            return $"{(ms / 1000.0):F2} с";
        }
        return $"{ms:F1} мс";
    }

    private async Task StartBenchmark()
    {
        if (currentAlgorithm == null) return;
        EnqueueCurrent();
    }

    private void EnqueueCurrent()
    {
        if (currentAlgorithm == null) return;
        SaveExperimentParams();
        QueueService.Enqueue(currentAlgorithm, nMin, nMax, step, runsPerN, forceRecalculate);
    }

    private async Task LoadExperimentParamsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "algolab_bench_params");
            if (string.IsNullOrEmpty(json)) return;
            var p = JsonSerializer.Deserialize<BenchParams>(json);
            if (p == null) return;
            if (p.NMin > 0) nMin = p.NMin;
            if (p.NMax > 0) nMax = p.NMax;
            if (p.Step > 0) step = p.Step;
            if (p.RunsPerN > 0) runsPerN = p.RunsPerN;
            forceRecalculate = p.ForceRecalculate;
        }
        catch { }
    }

    private void SaveExperimentParams()
    {
        try
        {
            var p = new BenchParams
            {
                NMin = nMin,
                NMax = nMax,
                Step = step,
                RunsPerN = runsPerN,
                ForceRecalculate = forceRecalculate
            };
            _ = JS.InvokeVoidAsync("localStorage.setItem", "algolab_bench_params", JsonSerializer.Serialize(p));
        }
        catch { }
    }

    private sealed class BenchParams
    {
        public int NMin { get; set; }
        public int NMax { get; set; }
        public int Step { get; set; }
        public int RunsPerN { get; set; }
        public bool ForceRecalculate { get; set; }
    }

    private async void HandleQueueState()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleItemStarted(BenchmarkQueueItem item)
    {
        if (currentAlgorithm != null && item.Algorithm.Id == currentAlgorithm.Id)
        {
            currentProgressN = item.NMin;
            outliersCount = 0;
            isFromCache = false;
            lastResult = null;
            await Chart.InitLiveChartAsync("liveChartCanvas", item.Algorithm.Name);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void HandlePointComputed(BenchmarkQueueItem item, BenchmarkPoint pt)
    {
        item.LivePoints.Add(pt);

        if (currentAlgorithm != null && item.Algorithm.Id == currentAlgorithm.Id)
        {
            currentProgressN = pt.N;
            if (pt.IsOutlier) outliersCount++;
            double val = (currentAlgorithm is IStepCountableAlgorithm) ? pt.StepCount : pt.AvgMs;
            double? theoVal = (currentAlgorithm is IStepCountableAlgorithm) ? null : pt.TheoMs;
            await Chart.AppendLivePointAsync("liveChartCanvas", pt.N, val, pt.IsOutlier, theoVal);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleItemCompleted(BenchmarkQueueItem item)
    {
        if (currentAlgorithm != null && item.Algorithm.Id == currentAlgorithm.Id && item.Result != null)
        {
            // Полная перерисовка всех точек одним вызовом
            await Chart.InitLiveChartAsync("liveChartCanvas", item.Algorithm.Name,
                isStepCounting: currentAlgorithm is IStepCountableAlgorithm);
            RenderCompletedResult(item.Result);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void RenderCompletedResult(ExperimentRecord result)
    {
        lastResult = result;
        currentProgressN = result.NMax;
        var outlierIndices = result.Points.Select((p, idx) => (p, idx)).Where(t => t.p.IsOutlier).Select(t => t.idx).ToList();
        outliersCount = outlierIndices.Count;

        var labels = result.Points.Select(p => p.N).ToList();
        var empData = (currentAlgorithm is IStepCountableAlgorithm)
            ? result.Points.Select(p => (double)p.StepCount).ToList()
            : result.Points.Select(p => p.AvgMs).ToList();
        var theoData = (currentAlgorithm is IStepCountableAlgorithm)
            ? null
            : result.Points.Select(p => p.TheoMs).ToList();

        isFromCache = false;
        _ = Chart.FinalizeChartAsync("liveChartCanvas", labels, empData, theoData, outlierIndices);
    }
}
