@using System.Diagnostics
@using AlgorithmLab.Core.Algorithms
@using AlgorithmLab.Core.Benchmark
@using AlgorithmLab.Core.Dataset
@using AlgorithmLab.Core.Models
@using AlgorithmLab.Interop
@using AlgorithmLab.Components

@inject IMasterDatasetProvider DatasetProvider
@inject PrecisionBenchmarkEngine BenchmarkEngine
@inject Plotly3DInterop Plotly3D

<div class="benchmark-workspace">
    <!-- Описание Части II ТЗ с исправленной семантической формулой -->
    <div class="controls-cockpit liquid-glass" style="flex-direction: column; align-items: flex-start; gap: 0.6rem;">
        <div style="font-size: 1rem; font-weight: 700; color: var(--accent-cyan);">
            Часть II. Операции с матрицами A(n×m) и B(m×n)
        </div>
        <div style="font-size: 0.84rem; color: var(--text-secondary); line-height: 1.5;">
            По техническому заданию исследуется классическое умножение прямоугольных матриц 
            <span class="mono-cell" style="color: var(--text-primary); font-weight: 600;">C = A × B</span> 
            размерностей <span class="mono-cell">A(n×m)</span> и <span class="mono-cell">B(m×n)</span> 
            (теоретическая сложность <span class="complexity-pill">O(n² · m)</span>, при n = m переходящая в <span class="complexity-pill">O(n³)</span>) 
            и строится <strong>трехмерный график зависимости машинного времени от размерностей n и m в реальном времени</strong>.
        </div>
    </div>

    <!-- Панель управления сеткой n x m с кастомными степперами -->
    <div class="controls-cockpit liquid-glass">
        <div class="param-group">
            <span class="param-label">n min:</span>
            <NumericStepper @bind-Value="nMin" Min="1" Max="2147483646" Step="5" Disabled="@isRunning" Width="60" />
        </div>
        <div class="param-group">
            <span class="param-label">n max:</span>
            <NumericStepper @bind-Value="nMax" Min="2" Max="2147483647" Step="10" Disabled="@isRunning" Width="65" />
        </div>
        <div class="param-group">
            <span class="param-label">Шаг n:</span>
            <NumericStepper @bind-Value="stepN" Min="1" Max="2147483647" Step="5" Disabled="@isRunning" Width="55" />
        </div>

        <div class="param-group">
            <span class="param-label">m min:</span>
            <NumericStepper @bind-Value="mMin" Min="1" Max="2147483646" Step="5" Disabled="@isRunning" Width="60" />
        </div>
        <div class="param-group">
            <span class="param-label">m max:</span>
            <NumericStepper @bind-Value="mMax" Min="2" Max="2147483647" Step="10" Disabled="@isRunning" Width="65" />
        </div>
        <div class="param-group">
            <span class="param-label">Шаг m:</span>
            <NumericStepper @bind-Value="stepM" Min="1" Max="2147483647" Step="5" Disabled="@isRunning" Width="55" />
        </div>

        <div class="btn-actions-group">
            @if (!isRunning)
            {
                <button class="btn-primary" @onclick="RunMatrix3DBenchmark">
                    <SvgIcon Name="play" Size="16" />
                    <span>Построить 3D</span>
                </button>
            }
            else
            {
                <button class="btn-danger" @onclick="Stop">
                    <SvgIcon Name="stop" Size="16" />
                    <span>Прервать</span>
                </button>
            }
        </div>
    </div>

    <!-- Телеметрия и замер полного времени построения -->
    <div class="telemetry-cockpit">
        <div class="telemetry-metric">
            <span class="metric-label">Точка сетки:</span>
            <span class="metric-value cyan">@(isRunning ? $"n = {currentN}, m = {currentM}" : $"n: {nMin}..{nMax}, m: {mMin}..{mMax}")</span>
        </div>
        <div class="telemetry-metric">
            <span class="metric-label">Время ячейки:</span>
            <span class="metric-value amber">@(currentTimeMs > 0 ? $"{currentTimeMs:F3} мс" : "—")</span>
        </div>
        <div class="telemetry-metric">
            <span class="metric-label">Итоговое время:</span>
            <span class="metric-value emerald">
                @(totalBuildTimeMs > 0 ? (totalBuildTimeMs >= 1000 ? $"{(totalBuildTimeMs / 1000.0):F2} с" : $"{totalBuildTimeMs:F0} мс") : (isRunning ? "Замер..." : "—"))
            </span>
        </div>
        @if (isRunning)
        {
            <div class="header-status-badge">
                <span class="status-dot pulsing online"></span>
                <span>Потоковое 3D построение...</span>
            </div>
        }
    </div>

    <!-- 3D Поверхность Plotly.js -->
    <div class="chart-panel liquid-glass">
        <div class="chart-header">
            <div class="chart-title-box">
                <h2>Интерактивная 3D-поверхность времени умножения матриц (Live 3D)</h2>
                <div class="chart-subtitle">
                    Вращайте модель левой кнопкой мыши, масштабируйте колесиком
                </div>
            </div>
        </div>

        <div id="plotly3dCanvas" style="width: 100%; height: 520px; min-height: 480px;"></div>
    </div>
</div>

@code {
    private int nMin = 15;
    private int nMax = 75;
    private int stepN = 15;

    private int mMin = 15;
    private int mMax = 75;
    private int stepM = 15;

    private bool isRunning = false;
    private int currentN = 0;
    private int currentM = 0;
    private double currentTimeMs = 0;
    private double totalBuildTimeMs = 0;
    private CancellationTokenSource? cts;

    private async Task RunMatrix3DBenchmark()
    {
        if (isRunning) return;
        isRunning = true;
        totalBuildTimeMs = 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        var totalSw = Stopwatch.StartNew();
        var matAlgo = new MatrixMultiplyAlgorithm();

        var nVals = new List<int>();
        for (int n = nMin; n <= nMax; n += stepN) nVals.Add(n);

        var mVals = new List<int>();
        for (int m = mMin; m <= mMax; m += stepM) mVals.Add(m);

        double[][] zMatrix = new double[nVals.Count][];
        for (int i = 0; i < nVals.Count; i++) zMatrix[i] = new double[mVals.Count];

        try
        {
            // Отрисовываем начальную поверхность
            await Plotly3D.RenderSurfaceAsync("plotly3dCanvas", nVals, mVals, zMatrix);

            int lastN = -1;

            await BenchmarkEngine.RunMatrix3DAsync(
                matAlgo,
                nMin, nMax, stepN,
                mMin, mMax, stepM,
                async pt =>
                {
                    currentN = pt.N;
                    currentM = pt.M;
                    currentTimeMs = pt.AvgMs;

                    int i = nVals.IndexOf(pt.N);
                    int j = mVals.IndexOf(pt.M);
                    if (i >= 0 && j >= 0)
                    {
                        zMatrix[i][j] = pt.AvgMs;
                    }

                    // Обновляем 3D график в реальном времени после завершения каждой строки n
                    if (pt.N != lastN || pt.M == mVals.Last())
                    {
                        lastN = pt.N;
                        await Plotly3D.UpdateSurfaceAsync("plotly3dCanvas", nVals, mVals, zMatrix);
                    }

                    await InvokeAsync(StateHasChanged);
                },
                cts.Token
            );

            // Финальное обновление
            await Plotly3D.UpdateSurfaceAsync("plotly3dCanvas", nVals, mVals, zMatrix);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"[Matrix3DView] Error: {ex.Message}");
        }
        finally
        {
            totalSw.Stop();
            totalBuildTimeMs = totalSw.Elapsed.TotalMilliseconds;
            isRunning = false;
            StateHasChanged();
        }
    }

    private void Stop()
    {
        cts?.Cancel();
        isRunning = false;
        StateHasChanged();
    }
}
