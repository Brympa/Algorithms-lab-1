@using System.Text.Json
@using AlgorithmLab.Core.Dataset
@using AlgorithmLab.Core.Models
@using AlgorithmLab.Services
@using AlgorithmLab.Components

@inject IMasterDatasetProvider DatasetProvider
@inject IExperimentStorageService Storage
@inject IJSRuntime JS

<div class="benchmark-workspace">
    <!-- Секция 1: Подключение к PostgreSQL 18 (DBeaver Style) -->
    <div class="chart-panel liquid-glass">
        <div class="chart-header">
            <div class="chart-title-box">
                <h2>Интеграция с базой данных (PostgreSQL 18 / Custom DB)</h2>
                <div class="chart-subtitle">
                    Подключение пользовательской БД PostgreSQL (в стиле DBeaver) или использование встроенного Docker-контейнера
                </div>
            </div>
            <div class="header-status-badge">
                <span class="status-dot @(Storage.Status == DatabaseStatus.ConnectedPostgreSql ? "online" : "local")"></span>
                <span>@Storage.StatusMessage</span>
            </div>
        </div>

        <!-- Переключатель режима: Docker по умолчанию vs Пользовательская БД -->
        <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
            <button class="btn-secondary @(!isCustomDb ? "active-tab" : "")" style="@(!isCustomDb ? "border-color: var(--accent-cyan); color: var(--accent-cyan);" : "")" @onclick="SelectDockerPreset">
                <SvgIcon Name="database" Size="15" />
                <span>Встроенный Docker (localhost:5432)</span>
            </button>
            <button class="btn-secondary @(isCustomDb ? "active-tab" : "")" style="@(isCustomDb ? "border-color: var(--accent-cyan); color: var(--accent-cyan);" : "")" @onclick="SelectCustomPreset">
                <SvgIcon Name="filter" Size="15" />
                <span>Пользовательская PostgreSQL (DBeaver)</span>
            </button>
        </div>

        <!-- Форма параметров подключения -->
        <div style="margin-top: 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.85rem;">
            <div>
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">Хост (Host / IP):</label>
                <input type="text" class="param-input" style="width: 100%;" @bind="dbConfig.Host" disabled="@(!isCustomDb)" />
            </div>

            <div>
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">Порт (Port):</label>
                <input type="number" class="param-input" style="width: 100%;" @bind="dbConfig.Port" disabled="@(!isCustomDb)" />
            </div>

            <div>
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">База данных (Database):</label>
                <input type="text" class="param-input" style="width: 100%;" @bind="dbConfig.Database" disabled="@(!isCustomDb)" />
            </div>

            <div>
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">Пользователь (Username):</label>
                <input type="text" class="param-input" style="width: 100%;" @bind="dbConfig.Username" disabled="@(!isCustomDb)" />
            </div>

            <div>
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">Пароль (Password):</label>
                <input type="password" class="param-input" style="width: 100%;" @bind="dbConfig.Password" disabled="@(!isCustomDb)" />
            </div>

            <div>
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">SSL Режим:</label>
                <select class="param-input" style="width: 100%;" @bind="dbConfig.SslMode" disabled="@(!isCustomDb)">
                    <option value="Prefer">Prefer (По умолчанию)</option>
                    <option value="Disable">Disable (Отключено)</option>
                    <option value="Require">Require (Обязательно)</option>
                </select>
            </div>
        </div>

        <!-- Настройка URL API бэкенда -->
        <div style="margin-top: 0.85rem; display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 260px;">
                <label class="param-label" style="display: block; margin-bottom: 0.25rem;">URL API бэкенда (AlgorithmLab.Server):</label>
                <input type="text" class="param-input" style="width: 100%; font-family: var(--font-mono); font-size: 0.8rem;" @bind="apiUrl" />
            </div>
        </div>

        <!-- Кнопки управления подключением в стиле DBeaver -->
        <div class="btn-actions-group" style="margin-top: 1.1rem; flex-wrap: wrap; gap: 0.6rem;">
            <button class="btn-secondary" @onclick="TestDbConnection" disabled="@isTesting">
                <SvgIcon Name="refresh" Size="16" />
                <span>@(isTesting ? "Тестирование связи..." : "Тест подключения (Test Connection)")</span>
            </button>

            <button class="btn-primary" @onclick="ApplyDbConnection" disabled="@isTesting">
                <SvgIcon Name="check" Size="16" />
                <span>Применить и подключиться (Apply)</span>
            </button>

            @if (isCustomDb)
            {
                <button class="btn-secondary" @onclick="ResetToDockerDefault">
                    <span>Сброс на дефолтный Docker</span>
                </button>
            }
        </div>

        <!-- Результат теста соединения -->
        @if (testResult != null)
        {
            <div style="margin-top: 0.9rem; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid @(testResult.Success ? "rgba(16, 185, 129, 0.4)" : "rgba(244, 63, 94, 0.4)"); background: @(testResult.Success ? "rgba(16, 185, 129, 0.1)" : "rgba(244, 63, 94, 0.1)");">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="status-dot @(testResult.Success ? "online" : "ruby")"></span>
                        <span style="font-weight: 600; font-size: 0.85rem; color: @(testResult.Success ? "var(--accent-emerald)" : "var(--accent-ruby)");">
                            @(testResult.Success ? "Успешное подключение" : "Ошибка подключения")
                        </span>
                        <span style="font-size: 0.82rem; color: var(--text-secondary);">@testResult.Message</span>
                    </div>
                    @if (testResult.Success)
                    {
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <span class="mono-cell" style="color: var(--accent-cyan); font-size: 0.78rem;">
                                Ping: @testResult.LatencyMs мс
                            </span>
                            @if (!string.IsNullOrEmpty(testResult.ServerVersion))
                            {
                                <span class="brand-badge" style="font-size: 0.72rem;">@testResult.ServerVersion</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; margin-top: 0.85rem;">
            Вы можете указать любую существующую PostgreSQL базу данных (локальную, сетевую или облачную). Сервер выполнит автоматическую инициализацию схемы таблиц (<code style="font-family: var(--font-mono); color: var(--accent-cyan);">experiments</code>, <code style="font-family: var(--font-mono); color: var(--accent-cyan);">benchmark_cache</code>). При отсутствии доступной БД приложение прозрачно использует локальный персистентный кэш в браузере.
        </div>
    </div>

    <!-- Секция 2: Загрузка и управление тестовыми данными на лету -->
    <div class="chart-panel liquid-glass">
        <div class="chart-header">
            <div class="chart-title-box">
                <h2>Управление набором данных (Master Dataset)</h2>
                <div class="chart-subtitle">
                    Единый эталонный вектор данных для всех алгоритмов и динамическая смена через JSON
                </div>
            </div>
            <div class="btn-actions-group">
                <button class="btn-secondary" @onclick="ExportConfig">
                    <SvgIcon Name="download" Size="16" />
                    <span>Экспорт JSON</span>
                </button>
                <button class="btn-secondary" @onclick="LoadSampleConfig">
                    <SvgIcon Name="refresh" Size="16" />
                    <span>Сброс на эталонный</span>
                </button>
            </div>
        </div>

        <!-- Параметры активного датасета -->
        <div class="telemetry-cockpit">
            <div class="telemetry-metric">
                <span class="metric-label">Сид генератора:</span>
                <span class="metric-value cyan">@DatasetProvider.Config.Seed</span>
            </div>
            <div class="telemetry-metric">
                <span class="metric-label">Распределение:</span>
                <span class="metric-value amber">@DatasetProvider.Config.Distribution</span>
            </div>
            <div class="telemetry-metric">
                <span class="metric-label">Размер предгенерации:</span>
                <span class="metric-value emerald">@DatasetProvider.Config.MaxPrecomputedSize</span>
            </div>
            <div class="telemetry-metric">
                <span class="metric-label">Конфиг хэш:</span>
                <span class="metric-value mono-cell" style="font-size: 0.78rem;">@DatasetProvider.Config.ComputeHash()</span>
            </div>
        </div>

        <!-- Интерактивная загрузка файла JSON -->
        <div style="margin-top: 1rem; padding: 1.25rem; background: rgba(10, 15, 29, 0.6); border-radius: var(--radius-md); border: 1px dashed var(--border-subtle);">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <div style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
                        Загрузка конфигурационного JSON-файла на лету:
                    </div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">
                        Выберите файл .json с вашей конфигурацией векторов или распределений. Данные в памяти обновятся мгновенно.
                    </div>
                </div>

                <div style="position: relative;">
                    <InputFile OnChange="HandleConfigFileUpload" accept=".json" class="btn-primary" style="opacity: 0; position: absolute; width: 100%; height: 100%; cursor: pointer;" />
                    <button class="btn-primary">
                        <SvgIcon Name="upload" Size="16" />
                        <span>Выбрать JSON-файл</span>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div style="margin-top: 0.8rem; font-size: 0.82rem; color: @statusColor; font-family: var(--font-mono);">
                    @statusMessage
                </div>
            }
        </div>

        <!-- Редактор JSON для ручной правки -->
        <div style="margin-top: 1rem;">
            <div style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.4rem;">
                Прямой просмотр и редактирование JSON:
            </div>
            <textarea class="param-input" style="width: 100%; height: 160px; resize: vertical;" @bind="jsonEditorText"></textarea>
            <div style="margin-top: 0.5rem; display: flex; justify-content: flex-end;">
                <button class="btn-secondary" @onclick="ApplyJsonFromEditor">
                    <SvgIcon Name="check" Size="16" />
                    <span>Применить из текстового поля</span>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string apiUrl = "http://localhost:5000/api";
    private bool isCustomDb = false;
    private bool isTesting = false;
    private DbConnectionConfig dbConfig = new();
    private DbConnectionTestResult? testResult;

    private string statusMessage = "";
    private string statusColor = "var(--accent-cyan)";
    private string jsonEditorText = "";

    protected override async Task OnInitializedAsync()
    {
        apiUrl = Storage.ApiUrl;
        UpdateJsonEditorText();

        // Загрузка сохраненной пользовательской конфигурации БД из localStorage
        try
        {
            var savedCustom = await JS.InvokeAsync<string?>("localStorage.getItem", "algolab_custom_pg_config");
            if (!string.IsNullOrEmpty(savedCustom))
            {
                var parsed = JsonSerializer.Deserialize<DbConnectionConfig>(savedCustom);
                if (parsed != null)
                {
                    dbConfig = parsed;
                    isCustomDb = true;
                }
            }
        }
        catch { }

        await Storage.CheckConnectionAsync();
    }

    private void SelectDockerPreset()
    {
        isCustomDb = false;
        dbConfig = new DbConnectionConfig
        {
            Host = "localhost",
            Port = 5432,
            Database = "algorithmlab",
            Username = "postgres",
            Password = "postgres",
            SslMode = "Prefer"
        };
        testResult = null;
    }

    private void SelectCustomPreset()
    {
        isCustomDb = true;
        testResult = null;
    }

    private void ResetToDockerDefault()
    {
        SelectDockerPreset();
        _ = JS.InvokeVoidAsync("localStorage.removeItem", "algolab_custom_pg_config");
    }

    private async Task TestDbConnection()
    {
        isTesting = true;
        testResult = null;
        Storage.ApiUrl = apiUrl;
        StateHasChanged();

        try
        {
            testResult = await Storage.TestDbConnectionAsync(dbConfig);
        }
        finally
        {
            isTesting = false;
            StateHasChanged();
        }
    }

    private async Task ApplyDbConnection()
    {
        isTesting = true;
        testResult = null;
        Storage.ApiUrl = apiUrl;
        StateHasChanged();

        try
        {
            testResult = await Storage.ApplyDbConnectionAsync(dbConfig);
            if (testResult.Success)
            {
                if (isCustomDb)
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", "algolab_custom_pg_config", JsonSerializer.Serialize(dbConfig));
                }
                await Storage.CheckConnectionAsync();
            }
        }
        finally
        {
            isTesting = false;
            StateHasChanged();
        }
    }

    private void UpdateJsonEditorText()
    {
        var options = new JsonSerializerOptions { WriteIndented = true };
        jsonEditorText = JsonSerializer.Serialize(DatasetProvider.Config, options);
    }

    private async Task HandleConfigFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var config = JsonSerializer.Deserialize<DatasetConfig>(content, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (config != null)
            {
                DatasetProvider.UpdateConfig(config);
                UpdateJsonEditorText();
                statusMessage = $"Конфигурация успешно загружена из файла '{file.Name}'! Хэш: {config.ComputeHash()}";
                statusColor = "var(--accent-emerald)";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Ошибка загрузки JSON: {ex.Message}";
            statusColor = "var(--accent-ruby)";
        }
    }

    private void ApplyJsonFromEditor()
    {
        try
        {
            var config = JsonSerializer.Deserialize<DatasetConfig>(jsonEditorText, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (config != null)
            {
                DatasetProvider.UpdateConfig(config);
                statusMessage = "Конфигурация успешно применена из текстового редактора!";
                statusColor = "var(--accent-emerald)";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Ошибка парсинга: {ex.Message}";
            statusColor = "var(--accent-ruby)";
        }
    }

    private void LoadSampleConfig()
    {
        var sample = new DatasetConfig
        {
            Seed = 42,
            Distribution = "RandomUniform",
            MaxPrecomputedSize = 25000,
            PolynomialX = 1.5,
            PowerBase = 1.05
        };
        DatasetProvider.UpdateConfig(sample);
        UpdateJsonEditorText();
        statusMessage = "Сброшено на эталонную конфигурацию.";
        statusColor = "var(--accent-cyan)";
    }

    private async Task ExportConfig()
    {
        UpdateJsonEditorText();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", jsonEditorText);
        statusMessage = "JSON конфигурации скопирован в буфер обмена!";
        statusColor = "var(--accent-cyan)";
    }
}
