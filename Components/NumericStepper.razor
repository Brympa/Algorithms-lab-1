@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Min { get; set; } = 1;
    [Parameter] public int Max { get; set; } = 100000;
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public int Width { get; set; } = 78;

    private async Task OnInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            val = Math.Clamp(val, Min, Max);
            Value = val;
            await ValueChanged.InvokeAsync(val);
        }
    }

    private async Task Decrement()
    {
        if (Disabled) return;
        int next = Math.Max(Min, Value - Step);
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }

    private async Task Increment()
    {
        if (Disabled) return;
        int next = Math.Min(Max, Value + Step);
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }
}

<div class="stepper-box">
    <button type="button" class="stepper-btn" @onclick="Decrement" disabled="@(Disabled || Value <= Min)">
        <span>−</span>
    </button>
    <input type="number" class="stepper-input" style="width: @(Width)px;"
           value="@Value" @onchange="OnInput" disabled="@Disabled" />
    <button type="button" class="stepper-btn" @onclick="Increment" disabled="@(Disabled || Value >= Max)">
        <span>+</span>
    </button>
</div>
